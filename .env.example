# Copy to .env and fill in. Used by run-local.sh and by docker compose.

# Where your phone reaches the server. For testing on your Mac, use the Mac's
# LAN IP (System Settings > Wi-Fi > Details), not localhost.
PUBLIC_URL=http://192.168.1.50:8686

ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional: for scripts/upload.sh
ADMIN_TOKEN=

# Optional: needed for Run build (fine-grained token, Actions read+write on your forks)
GITHUB_TOKEN=

# Hours between checks of the original repos for releases (0 = off)
UPDATE_CHECK_HOURS=6

# Decrypted IPAs uploaded for builds: hours a link lasts, and downloads it allows
UPLOAD_LINK_HOURS=3
UPLOAD_LINK_DOWNLOADS=5

# Docker only: the user the server runs as (Unraid's nobody:users)
PUID=99
PGID=100

# Docker only: where data is stored on the host
DATA_PATH=./data
